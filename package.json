{
  "name": "blaise-management-information-reports",
  "version": "1.0.0",
  "description": "",
  "main": "index.ts",
  "type": "module",
  "scripts": {
    "start": "node ./dist/server/index.js",
    "start-server": "tsc --project tsconfig.server.json && node --trace-deprecation ./dist/server/index.js | pino-pretty -c -t",
    "start-react": "react-scripts --openssl-legacy-provider start",
    "build": "yarn build:client && yarn build:server",
    "build:client": "yarn vite build",
    "build:server": "yarn tsc --project tsconfig.server.build.json",
    "postinstall": "patch-package",
    "test": "yarn vitest run --coverage",
    "test-watch": "yarn vitest",
    "typecheck": "yarn tsc --noEmit -p tsconfig.client.json && yarn tsc --noEmit -p tsconfig.server.json && yarn tsc --noEmit -p tsconfig.tooling.json",
    "gcp-build": "yarn build",
    "lint": "yarn typecheck && yarn eslint . --max-warnings 0 && yarn prettier --check . && yarn knip",
    "lint-fix": "yarn eslint . --fix && yarn prettier --write . && yarn knip --fix",
    "spellcheck": "yarn cspell \"**/*.{ts,tsx,json,jsonc,yml,yaml,md}\" --no-progress --no-summary",
    "integration-test": "playwright test tests/integration",
    "dev:client": "yarn vite",
    "dev": "yarn concurrently --kill-others-on-fail --names \"server,web\" \"yarn dev:server\" \"yarn dev:client\""
  },
  "proxy": "http://localhost:5000",
  "keywords": [],
  "author": "",
  "license": "ISC",
  "pre-commit": [
    "lint-fix"
  ],
  "resolutions": {
    "formik": "2.4.2",
    "strip-ansi": "6.0.1",
    "nth-check": "^2.0.1",
    "postcss": "^8.4.31",
    "serialize-javascript": "^7.0.3",
    "underscore": "^1.13.8",
    "@tootallnate/once": "^3.0.1"
  },
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/express": "^5.0.6",
    "@types/jest": "30.0.0",
    "@types/react-datepicker": "^7.0.0",
    "@types/react-dom": "^19.2.3",
    "axios": "^1.18.1",
    "blaise-api-node-client": "git+https://github.com/ONSdigital/blaise-api-node-client.git#3.0.0",
    "blaise-design-system-react-components": "git+https://github.com/ONSdigital/blaise-design-system-react-components#v2.0.0",
